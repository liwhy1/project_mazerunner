  m_TableData:
  - m_Id: 7945650176
    m_Localized: Player name can't be empty!
    m_Metadata:
      m_Items: []
  - m_Id: 139596464128
    m_Localized: Join code can't be empty!
    m_Metadata:
      m_Items: []
  - m_Id: 246647685120
    m_Localized: Failed to join game!
    m_Metadata:
      m_Items: []
  - m_Id: 307968409600
    m_Localized: Connection to the game host has been lost. Would you like to return
      to the main menu?
    m_Metadata:
      m_Items: []
  - m_Id: 376616583168
    m_Localized: Failed to load scene! Would you like to return to the main menu?
    m_Metadata:
      m_Items: []
  - m_Id: 531935854592
    m_Localized: Are you sure you want to clear the map?
    m_Metadata:
      m_Items: []
  - m_Id: 649984540672
    m_Localized: <b>Player movement:</b>\n(WASD) / (Point & Click)\n<b>Camera height
      control:</b>\n(Mouse Wheel) / (UI Plus & Minus icon)
    m_Metadata:
      m_Items: []
  - m_Id: 747229478912
    m_Localized: 'The treasure was reached in time! '
    m_Metadata:
      m_Items: []
  - m_Id: 825830735872
    m_Localized: Would you like to open the map editor?
    m_Metadata:
      m_Items: []
  - m_Id: 890137804800
    m_Localized: Would you like to see the mapmaking instructions?
    m_Metadata:
      m_Items: []
  - m_Id: 1005640548352
    m_Localized: Notice
    m_Metadata:
      m_Items: []
  - m_Id: 1118639292416
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 1206715482112
    m_Localized: Game End
    m_Metadata:
      m_Items: []
  - m_Id: 1661180903424
    m_Localized: Yes
    m_Metadata:
      m_Items: []
  - m_Id: 354238821105664
    m_Localized: Close
    m_Metadata:
      m_Items: []
  - m_Id: 1353409984266240
    m_Localized: '<b>Journal</b>\nUse the <b>Journal</b> to gather key information
      about the area, potential routes, and landmarks.\n<b>Note: The journal is only
      available during the individual mapping phase!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1354290771329024
    m_Localized: '<b>Icon Pile</b>\nUse the <b>Icon Pile</b> to place relevant landmarks
      and strategic indicators onto your map.\n<b>Note: You can drag and drop as
      many icons as you need based on your information!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1355021695909888
    m_Localized: '<b>Toolbar</b>\nUse the <b>Toolbar</b> to switch between tools,
      such as the placement tool and the drawing tool.\n<b>Note: Any tool can place
      icons, but only the placement tool allows moving placed icons!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1356298068754432
    m_Localized: '<b>Notes</b>\nUse the <b>Notes</b> tab to write down crucial details,
      observations, and clues about the area.\n<b>Note: Your notes will remain accessible
      continuously until the end of the game!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1356851909820416
    m_Localized: '<b>Save Icon</b>\nUse the <b>Save Icon</b> to save your map updates
      and signal that you are ready for the next stage.\n<b>Note: Saving disables
      map editing tools, but you can press it again to unlock them before the stage
      ends!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1611612588408832
    m_Localized: Continue
    m_Metadata:
      m_Items: []
  - m_Id: 1989706480615424
    m_Localized: The treasure was not reached in time!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
