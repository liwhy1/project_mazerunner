  m_Name: Dialog_Strings_nl-NL
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: nl-NL
  m_SharedData: {fileID: 11400000, guid: d9bdaa2be35e441459dc1094f7ed205d, type: 2}
  m_Metadata:
