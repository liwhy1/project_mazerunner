  m_TableData:
  - m_Id: 1661180903424
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 7945650176
    m_Localized: Spelersnaam mag niet leeg zijn!
    m_Metadata:
      m_Items: []
  - m_Id: 139596464128
    m_Localized: Join-code mag niet leeg zijn!
    m_Metadata:
      m_Items: []
  - m_Id: 246647685120
    m_Localized: Meedoen aan spel is mislukt!
    m_Metadata:
      m_Items: []
  - m_Id: 307968409600
    m_Localized: Verbinding met de host is verbroken. Wil je terug naar het hoofdmenu?
    m_Metadata:
      m_Items: []
  - m_Id: 376616583168
    m_Localized: "Laden van sc\xE8ne mislukt! Wil je terug naar het hoofdmenu?"
    m_Metadata:
      m_Items: []
  - m_Id: 531935854592
    m_Localized: Weet je zeker dat je de kaart wilt wissen?
    m_Metadata:
      m_Items: []
  - m_Id: 649984540672
    m_Localized: Spelersbeweging:\n(WASD) / (Point & Click)\nCamerahoogte:\n(Scrollwiel)
      / (Plus- & Min-icoon)
    m_Metadata:
      m_Items: []
  - m_Id: 890137804800
    m_Localized: Wil je de instructies voor het maken van kaarten bekijken?
    m_Metadata:
      m_Items: []
  - m_Id: 747229478912
    m_Localized: De schat is op tijd bereikt!
    m_Metadata:
      m_Items: []
  - m_Id: 825830735872
    m_Localized: Wil je de map-editor openen?
    m_Metadata:
      m_Items: []
  - m_Id: 1005640548352
    m_Localized: Melding
    m_Metadata:
      m_Items: []
  - m_Id: 1206715482112
    m_Localized: Einde spel
    m_Metadata:
      m_Items: []
  - m_Id: 1118639292416
    m_Localized: Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 354238821105664
    m_Localized: Sluiten
    m_Metadata:
      m_Items: []
  - m_Id: 1353409984266240
    m_Localized: '<b>Journaal</b>\nGebruik het <b>Journaal</b> om belangrijke informatie
      te verzamelen over het gebied, mogelijke routes en herkenningspunten.\n<b>Let
      op: Het journaal is alleen beschikbaar tijdens de individuele kaartfase!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1356298068754432
    m_Localized: '<b>Notities</b>\nGebruik het tabblad <b>Notities</b> om belangrijke
      details, observaties en aanwijzingen over het gebied op te schrijven.\n<b>Let
      op: Je notities blijven beschikbaar tot het einde van het spel!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1354290771329024
    m_Localized: '<b>Icoonstapel</b>\nGebruik de <b>Icoontjes</b> om relevante herkenningspunten
      en strategische indicatoren op je kaart te plaatsen.\n<b>Let op: Je kunt zo
      veel iconen slepen als je nodig hebt op basis van je informatie!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1355021695909888
    m_Localized: '<b>Werkbalk</b>\nGebruik de <b>Werkbalk</b> om te wisselen tussen
      gereedschappen, zoals de plaatsingstool en het tekengereedschap.\n<b>Let op:
      Tijdens het bebruik van elk gereedschap kunnen icoontjes geplaatst worden,
      maar alleen met de plaatsingstool kunnen ze verplaatst worden!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1356851909820416
    m_Localized: '<b>Opslaan-icoon</b>\nGebruik het <b>Opslaan-icoontje</b> om je
      kaart op te slaan en aan te geven dat je klaar bent voor de volgende fase.\n<b>Let
      op: Opslaan Schakelt de bewerkgereedschappen uit, maar je kunt er nogmaals
      op drukken om ze te ontgrendelen!</b>'
    m_Metadata:
      m_Items: []
  - m_Id: 1611612588408832
    m_Localized: Doorgaan
    m_Metadata:
      m_Items: []
  - m_Id: 1989706480615424
    m_Localized: De schat is niet op tijd bereikt!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
